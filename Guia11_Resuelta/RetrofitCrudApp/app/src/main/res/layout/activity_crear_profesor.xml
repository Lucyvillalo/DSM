<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/main" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Agregar Nuevo Profesor" android:textSize="24sp" android:textStyle="bold" android:gravity="center" />
    <EditText android:id="@+id/editTextNombre" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:hint="Nombre del profesor" android:inputType="textPersonName" />
    <EditText android:id="@+id/editTextApellido" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:hint="Apellido del profesor" android:inputType="textPersonName" />
    <EditText android:id="@+id/editTextEdad" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:hint="Edad del profesor" android:inputType="number" />
    <Button android:id="@+id/btnGuardar" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Guardar" />
</LinearLayout>
