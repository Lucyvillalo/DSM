<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".RegistroTableActivity">

    <TableLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/white"
        android:padding="24dp"
        android:stretchColumns="1">

        <TableRow android:background="@color/header_bg">
            <TextView
                android:layout_column="0"
                android:layout_span="2"
                android:gravity="center"
                android:padding="16dp"
                android:text="Registro (TableLayout)"
                android:textColor="@color/white"
                android:textSize="18sp"
                android:textStyle="bold" />
        </TableRow>

        <TableRow>
            <TextView
                android:padding="8dp"
                android:text="Nombre"
                android:textColor="@color/color_primary" />
            <EditText
                android:id="@+id/etNombre"
                android:layout_width="match_parent"
                android:hint="Ingresa tu nombre"
                android:inputType="textPersonName" />
        </TableRow>

        <TableRow>
            <TextView
                android:padding="8dp"
                android:text="Apellido"
                android:textColor="@color/color_primary" />
            <EditText
                android:id="@+id/etApellido"
                android:layout_width="match_parent"
                android:hint="Ingresa tu apellido"
                android:inputType="textPersonName" />
        </TableRow>

        <TableRow>
            <TextView
                android:padding="8dp"
                android:text="Correo"
                android:textColor="@color/color_primary" />
            <EditText
                android:id="@+id/etCorreo"
                android:layout_width="match_parent"
                android:hint="ejemplo@correo.com"
                android:inputType="textEmailAddress" />
        </TableRow>

        <TableRow>
            <TextView
                android:padding="8dp"
                android:text="Contraseña"
                android:textColor="@color/color_primary" />
            <EditText
                android:id="@+id/etContrasena"
                android:layout_width="match_parent"
                android:hint="Mínimo 8 caracteres"
                android:inputType="textPassword" />
        </TableRow>

        <TableRow>
            <TextView
                android:padding="8dp"
                android:text="Género"
                android:textColor="@color/color_primary" />

            <RadioGroup
                android:id="@+id/rgGenero"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <RadioButton
                    android:id="@+id/rbMasculino"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:buttonTint="@color/color_accent"
                    android:text="M" />

                <RadioButton
                    android:id="@+id/rbFemenino"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:buttonTint="@color/color_accent"
                    android:text="F" />
            </RadioGroup>
        </TableRow>

        <TableRow>
            <CheckBox
                android:id="@+id/cbTerminos"
                android:layout_column="0"
                android:layout_span="2"
                android:layout_marginTop="8dp"
                android:buttonTint="@color/color_accent"
                android:text="Acepto los términos y condiciones" />
        </TableRow>

        <TableRow>
            <Button
                android:id="@+id/btnRegistrar"
                android:layout_column="0"
                android:layout_span="2"
                android:layout_marginTop="16dp"
                android:backgroundTint="@color/color_button"
                android:text="Registrarme"
                android:textAllCaps="false"
                android:textColor="@color/white" />
        </TableRow>

    </TableLayout>
</androidx.constraintlayout.widget.ConstraintLayout>